# Modèle de configuration — copier en `.env` puis renseigner les valeurs.
#   cp .env.example .env && php artisan key:generate
#
# `.env` n'est PAS suivi par Git : il contient des secrets. Ce fichier-ci sert
# uniquement à documenter les variables attendues.

APP_NAME=Domtek
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Tunis

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données — `mysql` est le nom du service Docker Compose.
# Hors Docker, utiliser 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=domtekdb
DB_USERNAME=domtek_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Envoi d'e-mails — activation des comptes clients, factures, réinitialisation.
# Avec Gmail : MAIL_USERNAME et MAIL_FROM_ADDRESS doivent être la MÊME adresse
# @gmail.com, et MAIL_PASSWORD un mot de passe d'application de 16 caractères
# (validation en deux étapes requise). Gmail refuse d'expédier au nom d'un
# domaine qu'il ne contrôle pas.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Domtek"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe — paiement en ligne des factures
STRIPE_KEY=            # pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=         # sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET= # whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=eur

# URL du frontend Next.js : sert à construire les liens envoyés par e-mail
# (activation de compte, réinitialisation de mot de passe, paiement).
FRONTEND_URL=http://localhost

# Google OAuth — connexion « avec Google »
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Génération de descriptions de biens
GROQ_API_KEY=
GEMINI_API_KEY=

# Twilio — SMS de notification à la création d'une facture
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=  # numéro au format international, ex. +1xxxxxxxxxx
